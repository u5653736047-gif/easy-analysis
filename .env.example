# ===== OpenAI 官方 =====
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-mini          # 推理模型（gpt-5/o4-mini 等）才有思考链

# ===== 第三方 OpenAI 兼容中转（Base URL + Key + 模型名）=====
# 以下变量名会被自动映射为 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL
# 注意：端点必须支持 Responses API（/v1/responses）
BASE_URL="https://api.example.com/v1"
API_KEY=sk-your-key-here
MODEL_NAME=mimo-v2.6-flash

# ===== Jev（TypeSafe System One 结构化决策模型，可选）=====
# 用于题型分类等封闭选项集判断；不配置则相关工具自动降级为 LLM 判定
# TYPESAFE_API_KEY=sk-your-typesafe-key
